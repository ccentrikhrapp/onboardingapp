# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Vite only exposes vars prefixed with VITE_ to the browser.

# --- Supabase (frontend) ---
# Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where OAuth redirects back to in local dev (must be in Supabase Auth -> URL config)
VITE_SITE_URL=http://localhost:5173

# --- Edge function secrets (set with: supabase secrets set KEY=value) ---
# These are NOT VITE_ prefixed and never reach the browser.
# Outbound email is delegated to a Firebase Cloud Function over HTTPS.
# MAIL_FROM="Ccentrik Talent Acquisition <no-reply@ccentrik.com>"
# FIREBASE_MAIL_FUNCTION_URL=https://YOUR-REGION-YOUR-PROJECT.cloudfunctions.net/sendMail
# FIREBASE_MAIL_SHARED_SECRET=<the SAME long random value the Firebase function checks for>
#
# Public base URL used to build secure links inside emails
# PUBLIC_SITE_URL=http://localhost:5173
#
# Service-role key is injected automatically into deployed functions as
# SUPABASE_SERVICE_ROLE_KEY — do not set it here.

# --- Auth / Teams / invitations (edge function secrets: supabase secrets set KEY=value) ---
# Public URL of THIS app — used to build the one-time invitation link
# (<PUBLIC_SITE_URL>/accept-invite?token=...). Set it to the production
# (Vercel) URL in production; localhost only for development.
# PUBLIC_SITE_URL=http://localhost:5173
# How long an invitation link stays valid (days). Default 7.
# INVITATION_EXPIRY_DAYS=7
# Google OAuth client used for Gmail sending + Calendar (same client as the
# Supabase Google sign-in provider). Never expose these to the browser.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Invitation emails are sent from the inviting admin's own Gmail (they sign
# in with Google once so their token is stored). No shared mailbox/password.

# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# This is a SEPARATE Supabase project from the recruitment app's — its own
# database, auth and storage. See supabase/ in this app for its schema.

VITE_SUPABASE_URL=https://YOUR-HR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SITE_URL=http://localhost:5174

# --- Edge function secrets (set with: supabase secrets set KEY=value) ---
# Shared secret used to authenticate calls between this app's backend and the
# recruitment app's backend (both directions). Generate a long random value
# and set the SAME value in both projects.
# INTEGRATION_SHARED_SECRET=
#
# Base URL of the recruitment app's deployed edge functions, so this app's
# verify-document function can call back with the verification decision, and
# so it can request signed document URLs.
# RECRUITMENT_FUNCTIONS_URL=https://YOUR-RECRUITMENT-PROJECT-ref.supabase.co/functions/v1
